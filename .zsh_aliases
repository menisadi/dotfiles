# more versitle ls/eza version of the eza aliases
function e() {
 if [[ "$1" =~ ^[0-9]+$ ]]; then
  eza --sort=modified -r --icons=always --color=always | head -"$1"
 else
  eza --sort=modified -r --icons=always --color=always --group-directories-first "$@"
 fi
}

function el() {
 if [[ "$1" =~ ^[0-9]+$ ]]; then
  eza -l --sort=modified -r --icons=always --color=always | head -"$1"
 else
  eza -l --sort=modified -r --icons=always --color=always --group-directories-first "$@"
 fi
}

# Simple mkdir-cd combo
mkcd() {
 mkdir -p "$1" && cd "$1"
}

# create and open daily files
todaymd() {
 file="$(date +%Y-%m-%d).md"
 [ ! -f "$file" ] && touch "$file"
 ${EDITOR:-vim} "$file"
}

# My weather commands
function weather() {
 if [ "$1" = "-w" ]; then
  curl "wttr.in/Herzliya?format=3"
 elif [ "$1" = "-h" ]; then
  curl "wttr.in/Yeruham?format=3"
 elif [ -z "$1" ]; then
  curl "wttr.in/?format=3"
 else
  echo "Usage: weather [-w|-h]"
  echo "  -w: Get the weather for Herzliya"
  echo "  -h: Get the weather for Yeruham"
 fi
}

alias weathers="curl -s 'wttr.in/{Yeruham,Tel+Aviv,Ein+Hacarmel,Chicago,Baltimore}?format=%l:+%c+%t++⏰+%T\n' | sed 's/.....$//'"

function record() {
 local default_file="record.log"

 # Check if a command is provided
 if [ -z "$1" ]; then
  echo "No command provided. Usage: run_and_log 'command' [filename]"
  return 1
 fi

 # Get the command to run
 local command="$1"

 # Get the file name if provided, otherwise use the default
 local filename="${2:-$default_file}"

 # Run the command and use tee to write to the file and output to terminal
 eval "$command" | tee "$filename"
}

# yazi shell wrapper
function yy() {
 local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
 yazi "$@" --cwd-file="$tmp"
 if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
  builtin cd -- "$cwd"
 fi
 rm -f -- "$tmp"
}

cheat() {
 curl "https://cheat.sh/$1"
}

nvim-health() {
 local section="${1:-}"
 nvim --headless \
  +"checkhealth ${section}" \
  +"lua for _,b in ipairs(vim.api.nvim_list_bufs()) do local n=vim.api.nvim_buf_get_name(b); if n:match('^health://') then for _,l in ipairs(vim.api.nvim_buf_get_lines(b,0,-1,false)) do print(l) end; break end end" \
  +qall 2>&1
}

topcmds() {
 local n="${1:-20}"
 fc -ln 1 |
  sed -E 's/^[[:space:]]*//' |
  awk 'NF{
    cmd=$1
    if (cmd=="sudo") cmd=$2
    a[cmd]++
  } END{
    for (c in a) printf "%d\t%s\n", a[c], c
  }' |
  sort -nr | head -n "$n" |
  gum table -p -s $'\t' -c Count -c Command
}

export FZF_CTRL_R_OPTS=$'
  --no-multi-line
  # only 5 lines height
  --height=15
  --layout=reverse
  --border=rounded
  --info=inline-right
  --prompt="󰋚 history ❯ "
  --pointer="▶ "
  --marker="󰄬 "
  --header="enter: paste • ctrl-/: preview • esc: cancel"
  --bind=ctrl-/:toggle-preview,alt-/:toggle-wrap
  --preview-window=down:80%:wrap:hidden
  --preview=\'echo {} | bat --language=bash --style=plain --color=always\'
'

llmshell() {
 local cmd
 cmd=$(llm -m gemini-2.5-flash-lite \
  -s "Reply with the raw shell command only. No explanation, no commentary, no code fences, no backticks." \
  -x \
  "$@")
 echo "Generated Command:"
 echo "$cmd" | gum style --foreground 212 --padding "1 1" --italic

 local choice
 choice=$(gum choose "Run" "Copy" "Cancel")

 case $choice in
 "Run")
  eval "$cmd"
  ;;
 "Copy")
  echo "$cmd" | pbcopy
  echo "Command copied to clipboard."
  ;;
 "Cancel")
  echo "Operation canceled."
  ;;
 esac
}

_llmsh_impl() {
 local model="$1"
 shift
 local cmd
 cmd=$(llm -m "$model" \
  -s "Reply with the raw shell command only. No explanation, no commentary, no code fences, no backticks." \
  -x \
  "$@")
 echo "$ $cmd"
 print -n "[e]xecute  [y]ank  [q]uit: "
 read -rk 1 choice
 echo

 case $choice in
 e) echo && eval "$cmd" ;;
 y) echo "$cmd" | pbcopy && echo "Copied." ;;
 *) echo "Canceled." ;;
 esac
}

llmsh() { _llmsh_impl "gemini-2.5-flash" "$@"; }
ollmsh() { _llmsh_impl "mlx-community/Qwen2.5-Coder-3B-Instruct-4bit" "$@"; }
alias ai=llmsh
alias oai=ollmsh

ask() { llm -m "gemini-2.5-flash" -t terse "$@"; }
oask() { gum spin --show-output --spinner dot --title "Thinking..." -- llm -m mlx-community/Qwen3-4B-4bit-DWQ-053125 -t terse -o max_tokens 4096 "$@" | sed '/<think>/,/<\/think>/d' | sed '/./,$!d'; }
oaskf() { gum spin --show-output --spinner dot --title "Thinking..." -- llm -m mlx-community/Qwen3-4B-4bit-DWQ-053125 -t terse "/no_think $*" | sed '/<think>/,/<\/think>/d' | sed '/./,$!d'; }

jel() {
 local parent="$1"
 shift
 local mode="open" list=false

 while [[ $# -gt 0 ]]; do
  case "$1" in
   --all) mode="all"; shift ;;
   --list) list=true; shift ;;
   *) shift ;;
  esac
 done

 local status_flags=()
 [[ "$mode" == "open" ]] && status_flags=(--status "To Do" --status "In Progress")

 if [[ "$list" == true ]]; then
  jira issue list -P "$parent" "${status_flags[@]}" \
   --csv --columns "KEY,STATUS,ASSIGNEE,SUMMARY" 2>&1 |
   qsv table |
   cut -c1-"${COLUMNS:-$(tput cols)}"
  return 0
 fi

 local selected
 selected=$(jira issue list -P "$parent" "${status_flags[@]}" \
  --csv --columns "KEY,SUMMARY,STATUS,ASSIGNEE" 2>&1 |
  gum table -s ',')

 [[ -z "$selected" ]] && return 0

 local key
 key=$(echo "$selected" | cut -d',' -f1)
 jv "$key"
}

jpw() {
 local monday="" label="" mode="open" list=false
 while [[ $# -gt 0 ]]; do
  case "$1" in
   --label) label="$2"; shift 2 ;;
   --all) mode="all"; shift ;;
   --list) list=true; shift ;;
   --help|-h)
    echo "Usage: jpw [YYYY-MM-DD] [--label <label>] [--all] [--list]"
    echo "  YYYY-MM-DD   Monday of the desired week (default: this week)"
    echo "  --label      Restrict to a given Jira label"
    echo "  --all        Include all statuses (default: To Do, In Progress only)"
    echo "  --list       Print results without the interactive picker"
    return 0
    ;;
   -*) shift ;;
   *) monday="$1"; shift ;;
  esac
 done

 [[ -z "$monday" ]] && monday=$(date -v-$(($(date +%u)-1))d +%Y-%m-%d)
 local sunday
 sunday=$(date -j -v+6d -f "%Y-%m-%d" "$monday" +%Y-%m-%d)

 local jql="project IS NOT EMPTY AND assignee = currentUser() AND \"Planned Week\" >= \"$monday\" AND \"Planned Week\" <= \"$sunday\""
 [[ -n "$label" ]] && jql="$jql AND labels = \"$label\""

 local status_flags=()
 [[ "$mode" == "open" ]] && status_flags=(--status "To Do" --status "In Progress")

 if [[ "$list" == true ]]; then
  jira issue list -q "$jql" "${status_flags[@]}" \
   --csv --columns "KEY,STATUS,ASSIGNEE,SUMMARY" 2>&1 |
   qsv table |
   cut -c1-"${COLUMNS:-$(tput cols)}"
  return 0
 fi

 local selected
 selected=$(jira issue list -q "$jql" "${status_flags[@]}" \
  --csv --columns "KEY,SUMMARY,STATUS,ASSIGNEE" 2>&1 |
  gum table -s ',')

 [[ -z "$selected" ]] && return 0

 local key
 key=$(echo "$selected" | cut -d',' -f1)
 jv "$key"
}

jv() {
 jira issue view "$@" --plain 2>&1 | awk '
    { gsub(/\033\[[0-9;]*m/, ""); sub(/[[:space:]]+$/, ""); sub(/^ +/, "") }
    /^-+.*Subtasks/ { if (line) print line; exit }
    /^$/ { if (line) { print line; line="" }; if (!blank) print; blank=1; next }
    { blank=0; line = (line ? line " " $0 : $0) }
    END { if (line) print line }
  '

 local subtasks
 subtasks=$(jira issue view "$@" --raw 2>&1 | jq -r '
    .fields.subtasks[] |
    "\(.key)  \(.fields.summary)  •  \(.fields.priority.name)  •  \(.fields.status.name)"
  ')
 [[ -n "$subtasks" ]] && printf "\nSubtasks\n%s\n" "$subtasks"
}

js() {
 local mode="open" list=false

 while [[ $# -gt 0 ]]; do
  case "$1" in
   --all) mode="all"; shift ;;
   --list) list=true; shift ;;
   *) shift ;;
  esac
 done

 local jql="sprint in openSprints()"
 [[ "$mode" == "open" ]] && jql="$jql AND status != Done"

 if [[ "$list" == true ]]; then
  jira issue list --jql "$jql" \
   --csv --columns "KEY,STATUS,ASSIGNEE,PRIORITY,SUMMARY" 2>&1 |
   qsv table |
   cut -c1-"${COLUMNS:-$(tput cols)}"
  return 0
 fi

 local selected
 selected=$(jira issue list --jql "$jql" \
  --csv --columns "KEY,SUMMARY,STATUS,ASSIGNEE,PRIORITY" 2>&1 |
  gum table -s ',')

 [[ -z "$selected" ]] && return 0

 local key
 key=$(echo "$selected" | cut -d',' -f1)
 jv "$key"
}

jsm() {
 local jql="sprint in openSprints() AND assignee = currentUser() AND status != Done"

 local selected
 selected=$(jira issue list --jql "$jql" \
  --csv --columns "KEY,SUMMARY,STATUS,PRIORITY" 2>&1 |
  gum table -s ',')

 [[ -z "$selected" ]] && return 0

 local key
 key=$(echo "$selected" | cut -d',' -f1)
 jv "$key"
}

jsa() {
 local sprint_id="$1"
 if [[ -z "$sprint_id" ]]; then
  echo "Usage: jsa <SPRINT_ID> [--mine]"
  return 1
 fi

 local assignee_filter=()
 [[ "${2:-}" == "--mine" ]] && assignee_filter=(-a "$(jira me)")

 local keys
 keys=$(jira issue list -p DSI --status "To Do" "${assignee_filter[@]}" \
  --csv --columns "KEY,SUMMARY,ASSIGNEE,PRIORITY" 2>&1 |
  gum choose --no-limit --header "Pick tickets for sprint $sprint_id" |
  cut -d',' -f1 |
  tr '\n' ' ')

 [[ -z "${keys//[[:space:]]/}" ]] && return 0
 jira sprint add "$sprint_id" ${=keys}
}

# Create a taskwarrior task for the current git branch.
# project = repo name; tag = Jira key from the branch (hyphen -> underscore).
# Usage: tnew ["description"]  (defaults to the branch name)
tnew() {
 local root repo key
 root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "not in a git repo"
  return 1
 }
 repo=$(basename "$root")
 key=$(git symbolic-ref --short HEAD 2>/dev/null | grep -oE '^[A-Z]+-[0-9]+' | tr '-' '_')
 task add "${*:-$(git symbolic-ref --short HEAD)}" project:"$repo" ${key:+ +"$key"}
}
