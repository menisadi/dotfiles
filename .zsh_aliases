twg() {
 local tags
 tags=$(
  timew tags | tail -n +4 | awk '{print $1}' |
   gum filter --no-limit |
   tr '\n' ' '
 )

 [[ -z "${tags//[[:space:]]/}" ]] && return 0

 timew start ${=tags}
}

