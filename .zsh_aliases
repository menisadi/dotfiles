wcurl() { trafilatura -u "$1" --output-format txt 2>/dev/null | wc -w; }

websum() {
 trafilatura --markdown -u "$1" |
  llm -m mlx-community/Qwen3-4B-4bit-DWQ-053125 "Summarize this article in markdown. Write one short overview paragraph, then 4-5 bullet points covering the key ideas. Be concise — the entire summary should fit in under 20 lines." |
  glow -
}

# Pick a link from the bejw reading list and read it.
# Usage: bj [-f|--filter] [-l|--list] [-t|--table] [-P|--pager] [-T|--tui] [--read] [query]
bj() {
 local mode="filter" view="pager" include=() url

 while [[ $# -gt 0 ]]; do
  case "$1" in
   -f | --filter) mode="filter" && shift ;;
   -l | --list) mode="list" && shift ;;
   -t | --table) mode="table" && shift ;;
   -P | --pager) view="pager" && shift ;;
   -T | --tui) view="tui" && shift ;;
   --read) include=(--include-read) && shift ;;
   -h | --help)
    echo "Usage: bj [-f|--filter] [-l|--list] [-t|--table] [-P|--pager] [-T|--tui] [--read] [query]"
    echo "  Pick:"
    echo "    -f, --filter  Fuzzy-filter by title; [query] pre-fills the search (default)"
    echo "    -l, --list    Pick from a plain title list"
    echo "    -t, --table   Pick from a column table"
    echo "  View:"
    echo "    -P, --pager   Read in the glow pager (default)"
    echo "    -T, --tui     Read in the glow TUI, with line numbers"
    echo "  Other:"
    echo "        --read    Include links already marked as read"
    return 0
    ;;
   *) break ;;
  esac
 done

 case "$mode" in
 table)
  url=$(bejw list "${include[@]}" --format csv | gum table | awk -F',' '{print $NF}')
  ;;
 list | filter)
  local picker=(gum choose)
  [[ "$mode" == "filter" ]] && picker=(gum filter --value "$*")
  url=$(bejw list "${include[@]}" --format jsonl |
   jq -r '[.title, .url] | @tsv' |
   "${picker[@]}" |
   cut -f2)
  ;;
 esac

 if [[ -z "$url" ]]; then
  echo "No URL selected."
  return 1
 fi

 if [[ "$view" == "tui" ]]; then
  webread "$url" | glow -t -l
 else
  webread "$url" | glow -p
 fi
}

bejwc() {
 bejw list --format jsonl |
  jq -r '[.url, .title] | @tsv' |
  while IFS=$'\t' read -r url title; do
   words=$(trafilatura -u "$url" --output-format txt 2>/dev/null | wc -w | tr -d ' ')
   printf "%6s  %s\n" "$words" "$title"
  done
}

alias gpng='gping 1.1.1.1 8.8.8.8 -c red,green --clear'

pgc() {
 ping -i 1 google.com | awk -F'time=' '{
		if ($2 ~ /ms/) {
			split($2, a, " ms"); time=a[1]
			if (time < 50)       printf "\033[32mGood \033[0m"
			else if (time < 100) printf "\033[33mFair \033[0m"
			else if (time < 200) printf "\033[38;5;208mBad \033[0m"
			else                 printf "\033[31mFail \033[0m"
		} else printf "\033[31mFail \033[0m"
		fflush()
	}'
}

